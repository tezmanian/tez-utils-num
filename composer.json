{
    "name": "tezmanian/utils-num",
    "type": "library",
    "description": "PHP number utilities: formatting, byte sizes, percentage, clamping, and rounding helpers (Num), plus arbitrary-precision decimal arithmetic via bcmath (Bc). PHP 8.3+, requires ext-bcmath.",
    "keywords": [
        "number",
        "bcmath",
        "decimal",
        "format",
        "php"
    ],
    "homepage": "https://github.com/tezmanian/tez-utils-num",
    "license": "MIT",
    "authors": [
        {
            "name": "René Halberstadt",
            "email": "tezmanian@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/tezmanian/tez-utils-num/issues",
        "source": "https://github.com/tezmanian/tez-utils-num"
    },
    "autoload": {
        "psr-4": {
            "Tezmanian\\Utils\\Num\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tezmanian\\Utils\\Tests\\Num\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-bcmath": "*",
        "tezmanian/utils-validate": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "jetbrains/phpstorm-attributes": "^1.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse",
        "test": "phpunit --testsuite Unit --colors=always"
    }
}
